# ---------------------------------------------------------------------------
# Growing Technologies — production settings for deploy/docker-compose.yml
#   cp .env.production.example .env && chmod 600 .env
# Never commit deploy/.env (it is git-ignored).
# ---------------------------------------------------------------------------

# --- Domain & HTTPS ----------------------------------------------------------
# Bare domain, no scheme. DNS A/AAAA for it AND www.<domain> → this server.
# The site is served on https://SITE_DOMAIN; www redirects there. Changing it
# requires a rebuild (canonical URLs are baked in): docker compose up -d --build
SITE_DOMAIN=growing-technologies.tn
# Let's Encrypt account email (certificate expiry notices).
ACME_EMAIL=slahchmissi@gmail.com
# Leave empty in production. "local_certs" = self-signed, for a test run
# without public DNS (e.g. SITE_DOMAIN=localhost).
CADDY_GLOBAL_OPTIONS=

# --- Database ------------------------------------------------------------------
POSTGRES_USER=growingtech
POSTGRES_DB=growingtech
# Long random value, e.g.: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- CMS -----------------------------------------------------------------------
# Signs admin sessions; changing it logs everyone out. openssl rand -hex 32
PAYLOAD_SECRET=
DEFAULT_LOCALE=fr
# First admin, created by: docker compose --profile tools run --rm tools npm run seed
# (min. 12 characters; only used if that email doesn't exist yet). Clear the
# password from this file once the account exists.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Email (devis notifications, admin password reset) --------------------------
# 465 = implicit TLS, 587 = STARTTLS. Empty SMTP_HOST = emails only logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=devis@growing-technologies.tn
MAIL_FROM_NAME=Growing Technologies
DEVIS_NOTIFY_EMAIL=slahchmissi@gmail.com

# --- Telegram lead ping (optional) ----------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_URL=

# --- Analytics (optional, cookie-free) --------------------------------------------
# Domain as registered in Plausible; PLAUSIBLE_SRC only for self-hosted Plausible.
PLAUSIBLE_DOMAIN=
PLAUSIBLE_SRC=

# --- Backups -------------------------------------------------------------------
# Daily at this hour (TZ below) into deploy/backups/; files older than the
# retention are deleted. Copy that folder off the server too (see DEPLOY.md).
BACKUP_HOUR=3
BACKUP_RETENTION_DAYS=14
TZ=Africa/Tunis
