# ---------------------------------------------------------------------------
# Growing Technologies — environment variables
# Copy to .env.local for development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical, hreflang, OG tags, sitemap).
# Baked in at BUILD time for static pages — set it before `next build`
# in production, or every canonical URL will point to localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Default landing locale (fr | ar | en)
DEFAULT_LOCALE=fr

# --- Database & CMS (Phase 1: Payload) -------------------------------------
# Matches docker-compose.yml defaults (`npm run db:up`).
DATABASE_URI=postgres://growingtech:devpass@localhost:5432/growingtech
# Signs admin sessions. Generate one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me

# First admin account, created by `npm run seed` (min. 12 characters).
# Only used when that email doesn't exist yet; never overwrites a password.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Email / SMTP (Phase 5: devis notifications) ---------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
DEVIS_NOTIFY_EMAIL=slahchmissi@gmail.com

# --- Telegram lead ping (optional, Phase 5) --------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Analytics (optional, Phase 7) -----------------------------------------
PLAUSIBLE_DOMAIN=
