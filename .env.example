# ---------------------------------------------------------------------------
# Growing Technologies — environment variables
# Copy to .env.local for development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical, hreflang, OG tags, sitemap).
# Baked in at BUILD time for static pages — set it before `next build`
# in production, or every canonical URL will point to localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origin the site and /admin are served from, read at RUNTIME (defaults to
# NEXT_PUBLIC_SITE_URL). Payload only accepts the admin session cookie from this
# exact origin (CSRF protection): if it differs — e.g. admin opened on www. while
# this says the bare domain — every admin save fails with 403. Redirect www ↔ apex.
SERVER_URL=

# Default landing locale (fr | ar | en)
DEFAULT_LOCALE=fr

# --- Database & CMS (Phase 1: Payload) -------------------------------------
# Matches docker-compose.yml defaults (`npm run db:up`).
DATABASE_URI=postgres://growingtech:devpass@localhost:5432/growingtech
# Signs admin sessions. Generate one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me

# First admin account, created by `npm run seed` (min. 12 characters).
# Only used when that email doesn't exist yet; never overwrites a password.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Email / SMTP (Phase 5: devis notifications) ---------------------------
# Leave SMTP_HOST empty in development: emails are then printed to the console.
# Port 465 = implicit TLS; 587 = STARTTLS. Also used for admin password resets.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender address (must be allowed by your SMTP provider, ideally with SPF/DKIM).
MAIL_FROM=devis@growing-technologies.tn
MAIL_FROM_NAME=Growing Technologies
# Where new quote requests are sent (falls back to the Site settings email).
DEVIS_NOTIFY_EMAIL=slahchmissi@gmail.com

# --- Telegram lead ping (optional, Phase 5) --------------------------------
# Create a bot with @BotFather, add it to the team chat, put the chat id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only for a self-hosted Bot API server; defaults to https://api.telegram.org
TELEGRAM_API_URL=

# --- Analytics (optional, Phase 7) -----------------------------------------
PLAUSIBLE_DOMAIN=
